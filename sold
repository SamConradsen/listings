                <div class="cat-bubble sold-bubble" onclick="window.scrollTo({top:0, behavior:'smooth'})" title="Solgte varer"><img src="https://lh3.googleusercontent.com/d/1i583mUsElq7L9KIsg9mmizVUPflcOMq7" alt="SOLD"></div>
            `;
        }

        function renderItems() {
            let searchVal = document.getElementById('searchInput').value.toLowerCase();
            let filtered = items.filter(item => {
                const st = itemStates[item.id] || {};
                if (!st.sold) return false;
                return !searchVal || 
                    (item.name && item.name.toLowerCase().includes(searchVal)) ||
                    (item.brand && item.brand.toLowerCase().includes(searchVal)) ||
                    (item.size && item.size.toLowerCase().includes(searchVal)) ||
                    (st.buyerusername && st.buyerusername.toLowerCase().includes(searchVal)) ||
                    (item.id && item.id.toString().toLowerCase().includes(searchVal));
            });

            document.getElementById('totalCounterDisplay').textContent = `Solgte varer: ${filtered.length}`;

            const sortVal = document.getElementById('sortSelect').value;
            filtered.sort((a, b) => {
                const parseDate = (dateStr) => {
                    if (!dateStr) return 0;
                    const parts = dateStr.split('/');
                    if (parts.length === 3) return new Date(`${parts[2]}-${parts[1]}-${parts[0]}`).getTime();
                    return 0;
                };
                const dateA = parseDate(itemStates[a.id]?.saleDate);
                const dateB = parseDate(itemStates[b.id]?.saleDate);

                if (sortVal === 'date_asc') return dateA - dateB;
                if (sortVal === 'price_desc') {
                    let pA = parseFloat((itemStates[a.id]?.salePrice || '0').replace(/kr\.?/gi, '').replace(/\./g, '').replace(',', '.')) || 0;
                    let pB = parseFloat((itemStates[b.id]?.salePrice || '0').replace(/kr\.?/gi, '').replace(/\./g, '').replace(',', '.')) || 0;
                    return pB - pA;
                }
                return dateB - dateA;
            });

            let soldGroupsMap = {};
            filtered.forEach(item => {
                const st = itemStates[item.id] || {};
                const sDate = (st.saleDate || '').trim();
                const bUser = (st.buyerusername || '').trim().toLowerCase();
                const platform = (st.platform || '').trim().toLowerCase();
                const groupKey = `${sDate}__${bUser}__${platform}`;

                if (!soldGroupsMap[groupKey]) soldGroupsMap[groupKey] = [];
                soldGroupsMap[groupKey].push(item);
            });

            let soldBundles = [];
            let bundleColorIndex = 0;
            Object.keys(soldGroupsMap).forEach(key => {
                const colorObj = bundleColors[bundleColorIndex % bundleColors.length];
                bundleColorIndex++;
                soldBundles.push({ id: key, color: colorObj, items: soldGroupsMap[key] });
            });

            const maxPerRow = window.innerWidth >= 1200 ? 6 : (window.innerWidth >= 768 ? 5 : 3);
            let flatQueue = [];
            soldBundles.forEach(bundle => {
                bundle.items.forEach(item => {
                    flatQueue.push({ item: item, bundleId: bundle.id, color: bundle.color });
                });
            });

            let rows = [];
            for (let i = 0; i < flatQueue.length; i += maxPerRow) {
                rows.push(flatQueue.slice(i, i + maxPerRow));
            }

            let soldHtml = '';
            rows.forEach(rowItems => {
                let rowSegments = [];
                rowItems.forEach(qi => {
                    let lastSeg = rowSegments[rowSegments.length - 1];
                    if (lastSeg && lastSeg.bundleId === qi.bundleId) {
                        lastSeg.items.push(qi.item);
                    } else {
                        rowSegments.push({ bundleId: qi.bundleId, color: qi.color, items: [qi.item] });
                    }
                });

                let segmentsHtml = '';
                rowSegments.forEach(seg => {
                    const count = seg.items.length;
                    segmentsHtml += `
                        <div class="sold-bundle-segment" style="grid-column: span ${count}; grid-template-columns: repeat(${count}, 1fr); background-color: ${seg.color.bg}; border-color:${seg.color.border};">
                            ${seg.items.map(item => createCardHTML(item)).join('')}
                        </div>
                    `;
                });

                soldHtml += `<div class="sold-row" style="grid-template-columns: repeat(${maxPerRow}, 1fr);">${segmentsHtml}</div>`;
            });

            document.getElementById('soldContainer').innerHTML = soldHtml;
        }

